# Anthropic — required
ANTHROPIC_API_KEY=sk-ant-...

# Server
PORT=3001

# Deployment — at least one required for Deployer agent
RAILWAY_API_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Working directory for generated projects (defaults to OS temp dir)
PIXEL_WORK_DIR=

# Pixel platform database (Supabase)
PIXEL_SUPABASE_URL=https://xxxx.supabase.co
PIXEL_SUPABASE_SERVICE_KEY=sb_secret_...
